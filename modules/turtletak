    dialog --title "Marker type" --radiolist "How ATAK shows this Turtle. Alert markers keep their own red / yellow / green." 14 72 4 \
        sensor "Sensor (a-f-G-E-S), like the Hub Edition" "$([ $sel = sensor ] && echo on || echo off)" \
