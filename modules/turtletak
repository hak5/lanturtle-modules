menu_tls() {
    local free need cf tf cp tp msg days ask r install
    if ! has_openssl; then
        free=$(df -k /overlay 2>/dev/null | awk 'NR == 2 {print $4}')
        # the firmware may already have the OpenSSL library: then only the small openssl command is needed
        if opkg list-installed 2>/dev/null | grep -q '^libopenssl'; then need=350; else need=1300; fi
        if has_ncat; then
            ask="This Turtle can already do TLS with ncat, using .pem files (no install).\n\nTo use .p12 files instead, install openssl-util from the OpenWrt package server (the Turtle needs internet, once).\n\n  Free flash now:  $(awk -v k="${free:-0}" 'BEGIN {printf "%.1f MB", k / 1024}')\n  Needs about:     $(awk -v k="$need" 'BEGIN {printf "%.1f MB", k / 1024}')"
            dialog --title "TLS support" --yes-label "Use .pem" --no-label "Install" --yesno "$ask" 16 64
            r=$?
            [ "$r" -eq "$DIALOG_ESC" ] && return
            if [ "$r" -eq 0 ]; then install=0; else install=1; fi
        else
            ask="TLS needs openssl-util from the OpenWrt package server. The Turtle needs internet for this, once.\n\n  Free flash now:  $(awk -v k="${free:-0}" 'BEGIN {printf "%.1f MB", k / 1024}')\n  Needs about:     $(awk -v k="$need" 'BEGIN {printf "%.1f MB", k / 1024}')\n\nInstall it now?"
            dialog --title "TLS support" --yes-label "Install" --no-label "Not now" --yesno "$ask" 13 62 || return
            install=1
        fi
        if [ "$install" = 1 ]; then
            if [ "${free:-0}" -lt "$need" ]; then
                dialog --msgbox "Not enough free flash: $(awk -v k="${free:-0}" 'BEGIN {printf "%.1f", k / 1024}') MB free, about $(awk -v k="$need" 'BEGIN {printf "%.1f", k / 1024}') MB needed.$( has_ncat && printf '\n\nUse .pem files with ncat instead (no install).')" 9 64
                has_ncat || return
            else
                clear; echo "Installing openssl-util..."
                if opkg update && opkg install openssl-util; then echo; echo "Done."
                else echo; echo "Install failed: check the Turtle's internet connection and free space (df -h)."; fi
                echo "Press Enter to continue"; read -r _
            fi
        fi
        tls_ready || return
    fi
    mkdir -p "$CERTS"
    dialog --ok-label "Submit" --insecure --title "TLS certificates" \
        --mixedform "Copy the files to $CERTS/ (scp or WinSCP).\n$(has_openssl && echo ".p12 files (as for ATAK) with their passwords, or .pem files." || echo ".pem files: client cert + key without a password, and the CA. Leave passwords empty.")" 15 68 4 \
        "Client cert:" 1 1 "$(cfg tls_client)" 1 23 36 0 0 \
        "Client password:" 2 1 "$(cfg tls_client_pass)" 2 23 36 0 1 \
        "Truststore:" 3 1 "$(cfg tls_trust)" 3 23 36 0 0 \
        "Truststore password:" 4 1 "$(cfg tls_trust_pass)" 4 23 36 0 1 2> "$CONF" || return
    { read -r cf; read -r cp; read -r tf; read -r tp; } < "$CONF"
    cfg_set tls_client "$(basename "$cf")"; cfg_set tls_client_pass "$cp"
    cfg_set tls_trust "$(basename "$tf")"; cfg_set tls_trust_pass "$tp"; cfg_commit
    mkdir -p "$RUN"
    if msg=$(tls_prepare); then
        days=$(cert_days_left)
        dialog --title "TLS certificates" --msgbox "Certificates read OK.\n\nClient certificate valid for ${days:-?} more days." 9 55
    else
        dialog --title "TLS certificates" --msgbox "Problem: $msg" 7 55
    fi
}

