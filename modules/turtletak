function configure {
    local r running tak al
    mkdir -p "$RUN"
    cfg_init
    card_mount
    while :; do
        if [ "$(status)" = "1" ]; then running=yes; tak=$(state_get tak); else running=no; tak="-"; fi
        al=$(state_get alerts_today); [ "$(state_get alerts_day)" = "$(date +%j)" ] || al=0
        local items=(
            1 "TAK server          $(cfg host "(not set)"):$(cfg port 8087) $(cfg proto tcp | tr a-z A-Z)"
            2 "Callsign / place    $(cfg callsign "(not set)"), $(cfg site "-"), $(type_label "$(cot_type)")"
            3 "Network alerts      $(alerts_summary)"
            4 "Watched devices     $(cfg_list watch | grep -c .) watched"
            5 "TLS support         $(case "$(tls_tool)" in openssl) echo "openssl (.p12 / .pem)" ;; ncat) echo "ncat (.pem files)" ;; *) echo "not installed" ;; esac)")
        card_dir > /dev/null && items+=(6 "Alert log on card   $([ "$(cfg card_log 1)" = 1 ] && echo on || echo off)")
        items+=(7 "Send test to TAK" 8 "Help")
        dialog --no-collapse --title "TurtleTAK Classic $VERSION" --cancel-label "Done" \
            --menu "Running: $running   TAK: ${tak:--}   Alerts today: ${al:-0}" 18 66 8 "${items[@]}" 2> "$CONF"
        [ $? -eq "$DIALOG_OK" ] || break
        r=$(cat "$CONF")
        case "$r" in
            1) menu_server ;; 2) menu_place ;; 3) menu_alerts ;; 4) menu_watch ;;
            5) menu_tls ;; 6) menu_card ;; 7) menu_test ;; 8) menu_help ;;
        esac
    done
    rm -f "$CONF"
    restart_if_running
    clear
}
